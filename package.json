{
	"name": "finra-sec-crawler-dashboard",
	"version": "1.0.0",
	"main": "src/server.js",
	"type": "module",
	"scripts": {
		"start": "node src/server.js",
		"dev": "pnpm run kill-ports && next dev -p 3001",
		"kill-ports": "lsof -iTCP:3000 -sTCP:LISTEN -t | xargs -r kill -9 || true && lsof -iTCP:3001 -sTCP:LISTEN -t | xargs -r kill -9 || true",
		"build": "next build",
		"start:web": "next start",
		"type-check": "tsc --noEmit",
		"dev:server": "node src/server.js",
		"query-derived-crds": "tsx scripts/query-derived-crds.ts",
		"audit-external-crds": "tsx scripts/audit-external-crds.ts",
		"query-high-water-crds": "tsx scripts/query-high-water-crds.ts",
		"query-sequential-gap-crds": "tsx scripts/query-sequential-gap-crds.ts",
		"query-common-name-crds": "tsx scripts/query-common-name-crds.ts",
		"query-alnum-crds": "tsx scripts/query-alnum-crds.ts",
		"query-bank-name-crds": "tsx scripts/query-bank-name-crds.ts",
		"query-bank-name-crds-supervisor": "tsx scripts/query-bank-name-crds-supervisor.ts",
		"normalize-raw-iacontent": "tsx scripts/normalize-raw-iacontent.ts",
		"migrate-raw-keys": "tsx scripts/migrate-raw-keys.ts",
		"update-crd-log": "tsx scripts/update-crd-log.ts",
		"query-target-crds-supervisor": "tsx scripts/query-target-crds-supervisor.ts",
		"query-socrata-deeds": "tsx scripts/query-socrata-deeds.ts",
		"download-pdfs": "tsx scripts/download-all-pdfs.ts",
		"analyze-sec-resources": "tsx scripts/analyze-sec-resources.ts",
		"okcountyrecords-crawler": "tsx scripts/okcountyrecords-crawler.ts",
		"okcountyrecords-match-crds": "tsx scripts/okcountyrecords-match-crds.ts",
		"okcountyrecords-county-crawl": "tsx scripts/okcountyrecords-county-crawl.ts",
		"ingest-texas-bulk": "tsx scripts/ingest-texas-bulk.ts"
	},
	"dependencies": {
		"@upstash/redis": "^1.38.0",
		"axios": "^1.17.0",
		"cheerio": "^1.2.0",
		"dotenv": "^17.4.2",
		"express": "^4.18.2",
		"next": "^16.2.6",
		"node-fetch": "^3.3.2",
		"pdf-parse": "^1.1.1",
		"playwright": "^1.59.1",
		"playwright-extra": "^4.3.6",
		"puppeteer-extra-plugin-stealth": "^2.11.2",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"redis": "^5.12.1"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"concurrently": "^9.2.1",
		"puppeteer-core": "^25.4.0",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3"
	}
}
