{
	"name": "finra-sec-crawler-dashboard",
	"version": "1.0.0",
	"main": "src/server.mjs",
	"scripts": {
		"start": "node src/server.mjs",
		"dev": "bash /home/lenny/Dev/db/redis/start-redis.sh && pnpm run kill-ports && next dev -p 3001",
