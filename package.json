		"normalize-raw-iacontent": "tsx scripts/normalize-raw-iacontent.ts",
		"migrate-raw-keys": "tsx scripts/migrate-raw-keys.ts",
		"update-crd-log": "tsx scripts/update-crd-log.ts",
