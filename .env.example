# Same Upstash REST connection pattern as finra-data-chart-next-02.
# Local: copy to .env.local and fill from Upstash console (REST API tab).
# Vercel: Project → Settings → Environment Variables → Preview + Production.
#
# Both apps should use the SAME database so staging/prod share one cache:
#   https://console.upstash.com/redis/625518d5-a27e-4a18-9511-c37aa6ca47a2
#
# Required (canonical — matches finra-data-chart-next-02/src/lib/redisCache.ts):
UPSTASH_REDIS_REST_URL=https://<your-upstash-id>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>

# Local shared Redis (/home/lenny/Dev/db/redis → 127.0.0.1:6379 db0).
# In development, USE_LOCAL_REDIS=1 makes the app talk to that server instead of Upstash.
USE_LOCAL_REDIS=1
REDIS_URL=redis://127.0.0.1:6379
# REDIS_PASSWORD=

# Optional tuning used by pages/api/_lib.ts
# CACHE_TTL_SECONDS=3600
# PRIMED_REDIS_CHUNK_CHARS=900000
# RAW_KEYS_INDEX_CACHE_TTL_MS=300000
